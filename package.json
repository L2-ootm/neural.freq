{
  "name": "neural-freq",
  "version": "1.0.0",
  "private": true,
  "description": "An audio lab for focus and relaxation: build, hear and log your own binaural sessions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:copy": "node scripts/check-copy.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify": "npm run check:copy && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
